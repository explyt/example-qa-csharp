  "components": {
    "schemas": {
      "AgentSalesItem": {
        "type": "object",
        "properties": {
          "agentLogin": {
            "type": "string",
            "nullable": true
          },
          "sales": {
            "$ref": "#/components/schemas/SalesDto"
          }
        },
        "additionalProperties": false
      },
      "AgentsSalesResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AgentSalesItem"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PeriodItem": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "label": {
            "type": "string",
            "nullable": true
          },
          "sales": {
            "$ref": "#/components/schemas/SalesDto"
          }
        },
        "additionalProperties": false
      },
      "ProductSalesItem": {
        "type": "object",
        "properties": {
          "productCode": {
            "type": "string",
            "nullable": true
          },
          "sales": {
            "$ref": "#/components/schemas/SalesDto"
          }
        },
        "additionalProperties": false
      },
      "SalesDto": {
        "type": "object",
        "properties": {
          "policiesCount": {
            "type": "integer",
            "format": "int64"
          },
          "premiumAmount": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "SalesTrendsResponse": {
        "type": "object",
        "properties": {
          "periods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PeriodItem"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "TimeUnit": {
        "enum": [
          0,
          1,
          2,
          3
        ],
        "type": "integer",
        "format": "int32"
      },
      "TopAgentItem": {
        "type": "object",
        "properties": {
          "rank": {
            "type": "integer",
            "format": "int32"
          },
          "agentLogin": {
            "type": "string",
            "nullable": true
          },
          "sales": {
            "$ref": "#/components/schemas/SalesDto"
          }
        },
        "additionalProperties": false
      },
      "TopAgentsResponse": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TopAgentItem"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "TotalSalesResponse": {
        "type": "object",
        "properties": {
          "overall": {
            "$ref": "#/components/schemas/SalesDto"
          },
          "byProduct": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductSalesItem"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}